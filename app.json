{
  "expo": {
    "name": "Knockout",
    "slug": "karate-event-app",
    "version": "0.1.0",
    "scheme": "karate-event-app",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.karateevent.app"
    },
    "android": {
      "package": "com.karateevent.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      ["expo-image-picker", { "photosPermission": "Knockout uses your photos to set a tournament cover image." }],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111111"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "04951806-f39e-4fb7-a1f6-ee727fcea025"
      }
    },
    "owner": "pmjpraveen",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/04951806-f39e-4fb7-a1f6-ee727fcea025"
    }
  }
}
